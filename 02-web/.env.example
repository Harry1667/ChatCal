# Discord Bot
DISCORD_TOKEN=your_discord_bot_token
DISCORD_APPLICATION_ID=your_application_id
DISCORD_CHANNEL_ID=your_channel_id

# ProxyCLI (AI 服務)
AI_PROXY_HOST=cli.twloop.com
AI_PROXY_PORT=443
AI_PROXY_TLS=true
AI_PROXY_TOKEN=your_token
AI_PROXY_PROJECT=ChatCal
AI_PROXY_GROUP=webdev

# Web Server
PORT=3002
API_KEY=your_api_key_for_web

# 時區
TZ=Asia/Taipei
